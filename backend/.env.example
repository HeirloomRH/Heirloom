# Server Environment
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL / Supabase)
DATABASE_URL=postgresql://user:password@host:port/database

# Robinhood Chain (EVM Nitro L2 - Chain ID: 4663)
RHC_ID=4663
RHC_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Dedicated Vault Wallets & Key Management
# 12 or 24-word BIP-39 mnemonic to deterministically derive dedicated vault addresses per trust
VAULT_MASTER_MNEMONIC=
# 32-byte hex encryption key used to encrypt letters to beneficiaries and sensitive keys at rest
ENCRYPTION_KEY=
# Operator/Relayer wallet private key for automated distributions and gas sponsorship
OPERATOR_PRIVATE_KEY=

# Protocol Fee Treasury
PROTOCOL_FEE_WALLET=

# Orbio ($CREDIT / $ORBIO on Robinhood Chain) — leave the addresses unset to use
# the verified mainnet deployments; override only for a fork/testnet.
CREDIT_ADDRESS=
ORBIO_EXCHANGE_ADDRESS=
# Basis points above the $1.00 CREDIT peg a buy may pay before it is deferred
# instead of executed. Defaults to 200 (2%).
ORBIO_QUOTE_TOLERANCE_BPS=
# Heirloom's own concierge agent (setup/heartbeat/beneficiary Q&A), paid for
# with studio-held CREDIT via Orbio's OpenAI-compatible gateway. If left blank,
# falls back to RELAYER_PRIVATE_KEY/OPERATOR_PRIVATE_KEY above (approved
# tradeoff) — note that wallet holds standing approvals to SwapRouter02/
# Permit2/the Orbio Exchange, so the concierge path can reach those too. Set
# this explicitly to give the concierge its own wallet with no fund custody.
ORBIO_GATEWAY_URL=
ORBIO_STUDIO_PRIVATE_KEY=
# How often (ms) the inference-release worker polls for due CREDIT allowance
# releases. These execute unattended — a trust's own vault wallet
# (VAULT_MASTER_MNEMONIC-derived) buys and activates CREDIT to the
# beneficiary's key automatically once a schedule is configured. Defaults to
# 60000 (60s), same as the heartbeat worker.
INFERENCE_RELEASE_INTERVAL_MS=
# How often (ms) the stake-claim worker sweeps settled CREDIT from Orbio
# Staking into each staked trust's vault. Orbio settles hourly on its own
# keeper schedule; this just needs to poll faster than that. Defaults to
# 300000 (5 min).
STAKE_CLAIM_INTERVAL_MS=
