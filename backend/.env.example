# Server Environment
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL / Supabase)
DATABASE_URL=postgresql://user:password@host:port/database

# Robinhood Chain (EVM Nitro L2 - Chain ID: 4663)
RHC_ID=4663
RHC_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Dedicated Vault Wallets & Key Management
# 12 or 24-word BIP-39 mnemonic to deterministically derive dedicated vault addresses per trust
VAULT_MASTER_MNEMONIC=
# 32-byte hex encryption key used to encrypt letters to beneficiaries and sensitive keys at rest
ENCRYPTION_KEY=
# Operator/Relayer wallet private key for automated distributions and gas sponsorship
OPERATOR_PRIVATE_KEY=

# Protocol Fee Treasury
PROTOCOL_FEE_WALLET=
