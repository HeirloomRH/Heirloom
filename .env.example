# Frontend Environment Variables
VITE_API_URL=
VITE_ROBINHOOD_CHAIN_ID=
VITE_ROBINHOOD_RPC_URL=

# Atomic basket deposit (Uniswap v3 SwapRouter02 on Robinhood Chain).
# Optional: these default to the verified chain-specific deployments, which are
# NOT Uniswap's usual deterministic cross-chain addresses.
VITE_SWAP_ROUTER_ADDRESS=
VITE_V3_FACTORY_ADDRESS=
VITE_V3_QUOTER_ADDRESS=
VITE_WETH_ADDRESS=

# Orbio CREDIT leg (Orbio Exchange order book, not a Uniswap pool).
# Optional: defaults to the verified mainnet deployments.
VITE_CREDIT_ADDRESS=
VITE_ORBIO_EXCHANGE_ADDRESS=
